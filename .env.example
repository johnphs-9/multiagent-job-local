# Local Ollama workflow profile.
DEFAULT_MODEL_PROFILE=demo

# Ollama model assigned to each profile.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PREVIEW_MODEL=llama3.2:latest
OLLAMA_DEMO_MODEL=gemma4:latest
OLLAMA_DEEP_MODEL=gemma4:26b
# Keep structured-output tokens available instead of spending them on hidden thinking.
OLLAMA_REASONING_EFFORT=none

# Preview profile policy.
PROFILE_PREVIEW_LABEL=Ultra-fast preview
PROFILE_PREVIEW_DESCRIPTION=A minimal walkthrough with three role questions and one HR question.
PROFILE_PREVIEW_ROLE_QUESTION_COUNT=3
PROFILE_PREVIEW_HR_QUESTION_COUNT=1
PROFILE_PREVIEW_ANSWER_SELECTION_DEFAULT=2
PROFILE_PREVIEW_ANSWER_SELECTION_MAXIMUM=3
PROFILE_PREVIEW_MAX_ITERATIONS=1
PROFILE_PREVIEW_PASS_SCORE=4
PROFILE_PREVIEW_ANSWER_WORD_LIMIT=80
PROFILE_PREVIEW_MAX_TOKENS=2048
PROFILE_PREVIEW_SEARCH_REGION=sg-en

# Demo profile policy.
PROFILE_DEMO_LABEL=Fast demo
PROFILE_DEMO_DESCRIPTION=The recommended demonstration with concise answers and one review pass.
PROFILE_DEMO_ROLE_QUESTION_COUNT=8
PROFILE_DEMO_HR_QUESTION_COUNT=4
PROFILE_DEMO_ANSWER_SELECTION_DEFAULT=4
PROFILE_DEMO_ANSWER_SELECTION_MAXIMUM=12
PROFILE_DEMO_MAX_ITERATIONS=1
PROFILE_DEMO_PASS_SCORE=4
PROFILE_DEMO_ANSWER_WORD_LIMIT=120
PROFILE_DEMO_MAX_TOKENS=8192
PROFILE_DEMO_SEARCH_REGION=sg-en

# Deep profile policy.
PROFILE_DEEP_LABEL=Deep analysis
PROFILE_DEEP_DESCRIPTION=A comprehensive private run with more questions and up to three reviews.
PROFILE_DEEP_ROLE_QUESTION_COUNT=20
PROFILE_DEEP_HR_QUESTION_COUNT=6
PROFILE_DEEP_ANSWER_SELECTION_DEFAULT=26
PROFILE_DEEP_ANSWER_SELECTION_MAXIMUM=26
PROFILE_DEEP_MAX_ITERATIONS=3
PROFILE_DEEP_PASS_SCORE=4
PROFILE_DEEP_ANSWER_WORD_LIMIT=180
PROFILE_DEEP_MAX_TOKENS=8192
PROFILE_DEEP_SEARCH_REGION=sg-en

ENABLE_DEEP_PROFILE=true
LLM_TIMEOUT_SECONDS=600

# Ephemeral web runtime limits.
SESSION_IDLE_MINUTES=60
MAX_SESSIONS=50
JOB_WORKER_CONCURRENCY=1
JOB_QUEUE_SIZE=5
REQUEST_LIMIT_PER_HOUR=20

# Fix/build identifier shown in the API and UI.
APP_BUILD_TAG=20260731.3
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
